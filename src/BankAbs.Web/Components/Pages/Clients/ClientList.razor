@page "/clients"
@attribute [Authorize(Policy = Permissions.PolicyPrefix + Permissions.ClientsView)]
@inherits AppPageBase
@inject ClientRepository Clients
@inject ParameterRepository Parameters

<PageHeader Title="Клієнти" Icon="people" Subtitle="Реєстр фізичних і юридичних осіб, які обслуговуються у відділенні">
    @if (CurrentUser.Can(Permissions.ClientsEdit))
    {
        <a class="btn btn-primary" href="clients/new"><i class="bi bi-person-plus me-1"></i>Новий клієнт</a>
    }
</PageHeader>

<AlertMessage Success="@SuccessText" />

<div class="panel">
    <form method="get" action="clients" class="filter-bar">
        <SearchField Value="@Q" Placeholder="ПІБ, найменування, код, телефон, e-mail…" />
        <select name="kind" class="form-select" data-autosubmit aria-label="Тип клієнта">
            <option value="">Усі типи</option>
            <option value="@ClientTypes.Person" selected="@(Kind == ClientTypes.Person)">Фізичні особи</option>
            <option value="@ClientTypes.Legal" selected="@(Kind == ClientTypes.Legal)">Юридичні особи</option>
        </select>
        <select name="status" class="form-select" data-autosubmit aria-label="Стан">
            <option value="">Усі стани</option>
            <option value="@ClientStatuses.Active" selected="@(Status == ClientStatuses.Active)">Активні</option>
            <option value="@ClientStatuses.Blocked" selected="@(Status == ClientStatuses.Blocked)">Заблоковані</option>
        </select>
        @if (Sort is not null)
        {
            <input type="hidden" name="sort" value="@Sort" />
            <input type="hidden" name="desc" value="@(Desc == true ? "true" : "false")" />
        }
        <FilterButtons ResetUrl="clients" />
    </form>

    <div class="table-wrap">
        <table class="table table-sm table-hover">
            <thead>
                <tr>
                    <SortLink Column="name" Title="Клієнт" State="_state" />
                    <SortLink Column="type" Title="Тип" State="_state" />
                    <SortLink Column="taxId" Title="Код" State="_state" />
                    <th>Телефон</th>
                    <SortLink Column="accounts" Title="Рахунків" State="_state" CssClass="num" />
                    <SortLink Column="balance" Title="Кошти, грн" State="_state" CssClass="num" />
                    <SortLink Column="created" Title="Реєстрація" State="_state" />
                    <SortLink Column="status" Title="Стан" State="_state" />
                </tr>
            </thead>
            <tbody>
                @foreach (var client in _result.Items)
                {
                    <tr>
                        <td><a class="fw-semibold" href="clients/@client.Id">@client.FullName</a></td>
                        <td class="small">@ClientTypes.Title(client.ClientType)</td>
                        <td class="font-monospace">@client.TaxId</td>
                        <td class="small text-nowrap">@client.Phone</td>
                        <td class="num">@client.OpenAccounts</td>
                        <td class="num">@Fmt.Money(client.TotalBalanceBase)</td>
                        <td class="small">@Fmt.DateTime(client.CreatedAt)</td>
                        <td><StatusBadge Kind="client" Value="@client.Status" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <Pager Result="_result" State="_state" />
</div>

@code {
    private ListState _state = new();
    private PagedResult<Client> _result = PagedResult<Client>.Empty(ListQuery.DefaultPageSize);

    [SupplyParameterFromQuery] public string? Q { get; set; }
    [SupplyParameterFromQuery] public string? Sort { get; set; }
    [SupplyParameterFromQuery] public bool? Desc { get; set; }
    [SupplyParameterFromQuery] public int? Page { get; set; }
    [SupplyParameterFromQuery] public string? Kind { get; set; }
    [SupplyParameterFromQuery] public string? Status { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _state = new ListState
        {
            Path = "clients", Q = Q, Sort = Sort, Desc = Desc == true, Page = Page ?? 1,
            Kind = string.IsNullOrEmpty(Kind) ? null : Kind, Status = string.IsNullOrEmpty(Status) ? null : Status,
        };
        var pageSize = PageSizeOrDefault(await Parameters.GetIntAsync("ui.page_size", ListQuery.DefaultPageSize));
        _result = await Clients.ListAsync(_state.ToQuery(pageSize));
        if (_state.IsInitial)
        {
            await Audit.TableViewedAsync("client", "Клієнти");
        }
    }
}
