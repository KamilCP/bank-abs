@page "/help"
@attribute [Authorize]
@inherits AppPageBase

<PageHeader Title="Довідка" Icon="question-circle" Subtitle="Керівництво користувача Bank ABS" />

<div class="row g-3">
    <div class="col-lg-3 d-print-none">
        <nav class="panel position-sticky" style="top: 70px">
            <div class="panel-title"><i class="bi bi-list-ul"></i>Зміст</div>
            <ol class="small ps-3 mb-0">
                @foreach (var item in Sections)
                {
                    <li><a href="help#@item.Id">@item.Title</a></li>
                }
            </ol>
        </nav>
    </div>
    <div class="col-lg-9">
        @foreach (var item in Sections)
        {
            <section class="panel" id="@item.Id">
                <h2 class="h5"><i class="bi bi-@item.Icon text-primary me-2"></i>@item.Title</h2>
                @item.Body
            </section>
        }
    </div>
</div>

@code {
    private sealed record HelpSection(string Id, string Title, string Icon, RenderFragment Body);

    private static readonly HelpSection[] Sections =
    [
        new("start", "Початок роботи", "door-open", @<div>
            <p>Bank ABS — програма для працівників відділення банку. Увійдіть зі своїм логіном і паролем, отриманими від адміністратора.
               Після 5 невдалих спроб вхід блокується на 15 хвилин (значення задає адміністратор). Сеанс завершується автоматично
               після 30 хвилин бездіяльності.</p>
            <p class="mb-0">Меню ліворуч містить лише ті розділи, які доступні вашій ролі. Кнопка <b>Вийти</b> у верхньому правому куті
               завершує сеанс; вихід записується в журнал системи.</p>
        </div>),
        new("tables", "Робота з таблицями", "table", @<div>
            <ul class="mb-0">
                <li><b>Пошук</b> — введіть частину назви, номера чи коду в поле пошуку і натисніть Enter або «Знайти».</li>
                <li><b>Фільтри</b> — оберіть тип, стан, валюту або період у списках над таблицею; список застосовується одразу.</li>
                <li><b>Сортування</b> — натисніть заголовок колонки; повторне натискання змінює напрям (значок <i class="bi bi-sort-up"></i>/<i class="bi bi-sort-down"></i>).</li>
                <li><b>Сторінки</b> — кнопки під таблицею; кількість рядків задає параметр «ui.page_size».</li>
                <li>Вигляд таблиці зберігається в адресі сторінки — посилання можна додати в закладки.</li>
            </ul>
        </div>),
        new("clients", "Клієнти і рахунки", "people", @<div>
            <p>Розділ <b>Клієнти</b> — реєстр фізичних (РНОКПП, 10 цифр) і юридичних (код ЄДРПОУ, 8 цифр) осіб. Під час збереження програма
               перевіряє контрольну цифру коду, а для фізичної особи — відповідність дати народження коду.</p>
            <p class="mb-0">У картці клієнта відкриваються поточні рахунки у гривні чи валюті. Номер рахунку формується автоматично у форматі IBAN.
               Закрити можна лише рахунок з нульовим залишком. Заблокований клієнт не може проводити операції.</p>
        </div>),
        new("operations", "Каса і перекази", "cash-coin", @<div>
            <p><b>Каса</b>: оберіть тип операції (внесення або видача), почніть вводити номер рахунку чи ПІБ і оберіть рахунок у підказці,
               вкажіть суму. Після проведення сформується квитанція — надрукуйте її для клієнта.</p>
            <p class="mb-0"><b>Переказ</b>: оберіть рахунки списання і зарахування, вкажіть суму і натисніть «Розрахувати» — програма покаже
               курс і суму зарахування. Якщо валюти рахунків різні, конвертація виконується за офіційним курсом з урахуванням маржі банку.</p>
        </div>),
        new("deposits", "Депозити", "piggy-bank", @<div>
            <p>Щоб розмістити вклад, оберіть клієнта, депозитний продукт, рахунок списання і суму; кнопка «Розрахувати дохід» показує прогноз.
               Кошти переходять на окремий депозитний рахунок.</p>
            <p class="mb-0">Відсотки нараховуються щомісяця під час закриття дня (Адміністрування → Параметри): з капіталізацією — на рахунок вкладу,
               без неї — на рахунок виплати. Після завершення строку вклад повертається автоматично. Дострокове розірвання (якщо дозволене умовами)
               перераховує відсотки за ставкою «до запитання».</p>
        </div>),
        new("credits", "Кредити", "credit-card-2-front", @<div>
            <p>Видача кредиту: клієнт → продукт → рахунок зарахування → сума і строк → «Розрахувати графік» → «Видати кредит».
               Платежі ануїтетні (рівні щомісяця). Кредит не видається клієнту з простроченою заборгованістю.</p>
            <p class="mb-0">У картці кредиту кнопка «Сплатити платіж» списує черговий платіж з поточного рахунку. Неоплачені платежі з минулою датою
               виділяються червоним, кредит отримує стан «Прострочений».</p>
        </div>),
        new("reports", "Звіти і статистика", "printer", @<div>
            <p>Звіти: виписка по рахунку, реєстр операцій за день, портфель депозитів і кредитів, графік погашення кредиту.
               Кнопка «Друкувати» відкриває діалог друку; меню і кнопки на друк не виводяться.</p>
            <p class="mb-0">Статистика показує кількість і оборот операцій по днях, структуру обороту, кошти за валютами, стан кредитів і рейтинг клієнтів
               за обраний період.</p>
        </div>),
        new("admin", "Адміністрування", "shield-lock", @<div>
            <ul class="mb-0">
                <li><b>Користувачі</b> — створення облікових записів, зміна ролі, блокування, встановлення пароля, зняття блокування після невдалих входів.</li>
                <li><b>Ролі і права</b> — матриця «роль × функція»; зміни діють з наступного запиту користувача.</li>
                <li><b>Журнал системи</b> — вхід/вихід, зміни даних (старе і нове значення полів), відкриття таблиць, звіти; фільтри за періодом, користувачем, подією, таблицею.</li>
                <li><b>Параметри</b> — назва банку, маржа конвертації, правила безпеки, розмір сторінки таблиць; закриття операційного дня.</li>
            </ul>
        </div>),
        new("errors", "Повідомлення про помилки", "exclamation-triangle", @<div>
            <table class="table table-sm mb-0">
                <thead><tr><th>Повідомлення</th><th>Що робити</th></tr></thead>
                <tbody>
                    <tr><td>Недостатньо коштів на рахунку</td><td>Зменште суму або поповніть рахунок</td></tr>
                    <tr><td>Клієнт рахунку заблокований</td><td>Зверніться до операціоніста з правом редагування клієнтів</td></tr>
                    <tr><td>Дата народження не відповідає РНОКПП</td><td>Перевірте код і дату за документом клієнта</td></tr>
                    <tr><td>Доступ заборонено</td><td>Функція недоступна вашій ролі — зверніться до адміністратора</td></tr>
                    <tr><td>Дані одночасно змінюються іншим користувачем</td><td>Повторіть операцію</td></tr>
                </tbody>
            </table>
        </div>),
    ];
}
