@page "/credits/new"
@attribute [Authorize(Policy = Permissions.PolicyPrefix + Permissions.CreditsManage)]
@inherits AppPageBase
@inject ClientRepository Clients
@inject AccountRepository Accounts
@inject DirectoryRepository Directories
@inject CreditRepository Credits

<PageHeader Title="Видача кредиту" Icon="credit-card-2-front" ParentTitle="Кредити" ParentHref="credits"
            Subtitle="Кредит видається на поточний рахунок клієнта; погашення — щомісяця рівними (ануїтетними) платежами" />

<AlertMessage Errors="Errors" />

@if (_client is null)
{
    <ClientChooser Path="credits/new" Query="@Q" />
}
else
{
    <form method="post" @formname="credit" @onsubmit="SubmitAsync" class="panel" style="max-width: 980px">
        <AntiforgeryToken />
        <div class="panel-title"><i class="bi bi-file-earmark-plus"></i>Крок 2. Умови кредиту</div>
        <div class="picked-item mb-3">
            <div><div class="fw-semibold">@_client.FullName</div><div class="small text-secondary">@ClientTypes.Title(_client.ClientType) · код @_client.TaxId</div></div>
            <a class="btn btn-sm btn-outline-secondary" href="credits/new">Інший клієнт</a>
        </div>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label required" for="product">Кредитний продукт</label>
                <select id="product" name="product" class="form-select" required>
                    @foreach (var product in _products)
                    {
                        <option value="@product.Id" selected="@(product.Id == _productId)">@product.Name — @Fmt.Rate(product.AnnualRate), @product.MinTermMonths–@product.MaxTermMonths міс.</option>
                    }
                </select>
                @if (SelectedProduct is { } p)
                {
                    <div class="form-hint mt-1">Сума від @Fmt.Money(p.MinAmount) до @Fmt.Money(p.MaxAmount, p.CurrencyCode)</div>
                }
            </div>
            <div class="col-md-6">
                <label class="form-label required" for="account">Поточний рахунок для зарахування і погашення</label>
                <select id="account" name="account" class="form-select" required>
                    @if (_accounts.Count == 0)
                    {
                        <option value="">У клієнта немає відкритих поточних рахунків</option>
                    }
                    @foreach (var account in _accounts)
                    {
                        <option value="@account.Id" selected="@(account.Id == _accountId)">@Fmt.Iban(account.Number) — @account.CurrencyCode</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label required" for="amount">Сума кредиту</label>
                <input id="amount" name="amount" type="number" min="1" step="0.01" class="form-control text-end" value="@_amount?.ToString(CultureInfo.InvariantCulture)" required />
            </div>
            <div class="col-md-3">
                <label class="form-label required" for="term">Строк, міс.</label>
                <input id="term" name="term" type="number" min="1" max="360" class="form-control text-end" value="@_term" required />
            </div>
        </div>

        @if (_schedule is not null && SelectedProduct is { } sp)
        {
            <div class="preview mt-3">
                <div class="fw-semibold mb-2"><i class="bi bi-calculator me-1"></i>Попередній графік погашення</div>
                <dl class="row mb-2">
                    <dt class="col-sm-4">Щомісячний платіж</dt><dd class="col-sm-8 fs-5">@Fmt.Money(_schedule[0].Payment, sp.CurrencyCode)</dd>
                    <dt class="col-sm-4">Переплата (відсотки)</dt><dd class="col-sm-8">@Fmt.Money(AnnuityCalculator.TotalInterest(_schedule), sp.CurrencyCode)</dd>
                    <dt class="col-sm-4">Загальна сума виплат</dt><dd class="col-sm-8">@Fmt.Money(_schedule.Sum(r => r.Payment), sp.CurrencyCode)</dd>
                </dl>
                <div class="table-wrap" style="max-height: 280px; overflow-y: auto">
                    <table class="table table-sm mb-0">
                        <thead><tr><th>№</th><th>Дата</th><th class="num">Платіж</th><th class="num">Тіло</th><th class="num">Відсотки</th><th class="num">Залишок</th></tr></thead>
                        <tbody>
                            @foreach (var row in _schedule)
                            {
                                <tr><td>@row.Number</td><td>@Fmt.Date(row.DueDate)</td><td class="num">@Fmt.Money(row.Payment)</td><td class="num">@Fmt.Money(row.Principal)</td><td class="num">@Fmt.Money(row.Interest)</td><td class="num">@Fmt.Money(row.BalanceAfter)</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <div class="d-flex gap-2 mt-4">
            <button type="submit" name="action" value="preview" class="btn btn-outline-primary"><i class="bi bi-calculator me-1"></i>Розрахувати графік</button>
            <button type="submit" name="action" value="confirm" class="btn btn-primary" data-confirm="Видати кредит і зарахувати кошти на поточний рахунок клієнта?"><i class="bi bi-check2-circle me-1"></i>Видати кредит</button>
            <a class="btn btn-outline-secondary" href="clients/@_client.Id">Скасувати</a>
        </div>
    </form>
}

@code {
    private const int DefaultTermMonths = 12;
    private Client? _client;
    private List<CreditProduct> _products = [];
    private List<Account> _accounts = [];
    private int _productId;
    private int _accountId;
    private decimal? _amount;
    private int _term = DefaultTermMonths;
    private IReadOnlyList<ScheduleRow>? _schedule;

    [SupplyParameterFromQuery(Name = "client")] public int? ClientId { get; set; }
    [SupplyParameterFromQuery] public string? Q { get; set; }

    private CreditProduct? SelectedProduct => _products.FirstOrDefault(p => p.Id == _productId);

    protected override async Task OnInitializedAsync()
    {
        if (ClientId is null)
        {
            return;
        }

        _client = await Clients.GetAsync(ClientId.Value);
        if (_client is null || _client.Status != ClientStatuses.Active)
        {
            _client = null;
            return;
        }

        _products = await Directories.CreditProductsAsync(activeOnly: true);
        _accounts = await Accounts.ListOpenCurrentAsync(null, _client.Id);
        // За замовчуванням — перший продукт у валюті одного з рахунків клієнта
        _productId = (_products.FirstOrDefault(p => _accounts.Any(a => a.CurrencyCode == p.CurrencyCode)) ?? _products.FirstOrDefault())?.Id ?? 0;
        _accountId = _accounts.FirstOrDefault()?.Id ?? 0;
    }

    private async Task SubmitAsync()
    {
        if (_client is null)
        {
            return;
        }

        var form = Form;
        _productId = form.Int("product") ?? 0;
        _accountId = form.Int("account") ?? 0;
        _amount = form.Decimal("amount");
        _term = form.Int("term") ?? 0;
        var product = SelectedProduct;
        if (product is null)
        {
            Errors.Add("Оберіть кредитний продукт");
        }

        if (_amount is not > 0)
        {
            Errors.Add("Вкажіть суму кредиту");
        }

        if (_term <= 0)
        {
            Errors.Add("Вкажіть строк кредиту в місяцях");
        }

        // Умови продукту перевіряються вже на кроці розрахунку, щоб не показувати графік, який неможливо видати
        if (product is not null && _amount is > 0 && (_amount < product.MinAmount || _amount > product.MaxAmount))
        {
            Errors.Add($"Сума кредиту за продуктом «{product.Name}» — від {Fmt.Money(product.MinAmount)} до " +
                $"{Fmt.Money(product.MaxAmount, product.CurrencyCode)}");
        }

        if (product is not null && _term > 0 && (_term < product.MinTermMonths || _term > product.MaxTermMonths))
        {
            Errors.Add($"Строк кредиту за продуктом «{product.Name}» — від {product.MinTermMonths} до {product.MaxTermMonths} міс.");
        }

        if (Errors.Count > 0)
        {
            return;
        }

        _schedule = AnnuityCalculator.BuildSchedule(_amount!.Value, product!.AnnualRate, _term, Fmt.Today);
        if (form.Text("action") != "confirm")
        {
            return;
        }

        var id = 0;
        if (await TryAsync(async () => id = await Credits.IssueAsync(_client.Id, _productId, _amount.Value, _term, _accountId)))
        {
            RedirectWithNotice($"credits/{id}", "credit-issued");
        }
    }
}
