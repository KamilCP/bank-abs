@page "/credits"
@attribute [Authorize(Policy = Permissions.PolicyPrefix + Permissions.CreditsView)]
@inherits AppPageBase
@inject CreditRepository Credits
@inject ParameterRepository Parameters

<PageHeader Title="Кредити" Icon="credit-card-2-front" Subtitle="Кредитні договори, графіки погашення і прострочена заборгованість">
    @if (CurrentUser.Can(Permissions.CreditsManage))
    {
        <a class="btn btn-primary" href="credits/new"><i class="bi bi-plus-lg me-1"></i>Видати кредит</a>
    }
</PageHeader>

<div class="panel">
    <form method="get" action="credits" class="filter-bar">
        <SearchField Value="@Q" Placeholder="Клієнт, рахунок, продукт…" />
        <select name="status" class="form-select" data-autosubmit aria-label="Стан">
            <option value="">Усі стани</option>
            <option value="@CreditStatuses.Active" selected="@(Status == CreditStatuses.Active)">Діючі</option>
            <option value="@CreditStatuses.Overdue" selected="@(Status == CreditStatuses.Overdue)">Прострочені</option>
            <option value="@CreditStatuses.Repaid" selected="@(Status == CreditStatuses.Repaid)">Погашені</option>
        </select>
        <input type="date" name="from" class="form-control" value="@From?.ToString("yyyy-MM-dd")" title="Видано з" aria-label="Видано з" />
        <input type="date" name="to" class="form-control" value="@To?.ToString("yyyy-MM-dd")" title="Видано по" aria-label="Видано по" />
        @if (Sort is not null)
        {
            <input type="hidden" name="sort" value="@Sort" />
            <input type="hidden" name="desc" value="@(Desc == true ? "true" : "false")" />
        }
        <FilterButtons ResetUrl="credits" />
    </form>
    <div class="table-wrap">
        <table class="table table-sm table-hover">
            <thead>
                <tr>
                    <SortLink Column="id" Title="№" State="_state" />
                    <SortLink Column="client" Title="Клієнт" State="_state" />
                    <SortLink Column="product" Title="Продукт" State="_state" />
                    <SortLink Column="amount" Title="Сума" State="_state" CssClass="num" />
                    <SortLink Column="debt" Title="Залишок боргу" State="_state" CssClass="num" />
                    <th class="num">Платіж</th>
                    <SortLink Column="issue" Title="Видано" State="_state" />
                    <SortLink Column="next" Title="Наступний платіж" State="_state" />
                    <SortLink Column="status" Title="Стан" State="_state" />
                </tr>
            </thead>
            <tbody>
                @foreach (var credit in _result.Items)
                {
                    <tr>
                        <td><a href="credits/@credit.Id">@credit.Id</a></td>
                        <td><a class="text-body" href="clients/@credit.ClientId">@credit.ClientName</a></td>
                        <td class="small">@credit.ProductName · @Fmt.Rate(credit.AnnualRate), @credit.TermMonths міс.</td>
                        <td class="num">@Fmt.Money(credit.Amount, credit.CurrencyCode)</td>
                        <td class="num fw-semibold">@Fmt.Money(credit.Debt)</td>
                        <td class="num">@Fmt.Money(credit.MonthlyPayment)</td>
                        <td class="small">@Fmt.Date(credit.IssueDate)</td>
                        <td class="small @(credit.NextDueDate < Fmt.Today ? "text-danger fw-semibold" : "")">@Fmt.Date(credit.NextDueDate)</td>
                        <td><StatusBadge Kind="credit" Value="@credit.Status" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <Pager Result="_result" State="_state" />
</div>

@code {
    private ListState _state = new();
    private PagedResult<Credit> _result = PagedResult<Credit>.Empty(ListQuery.DefaultPageSize);

    [SupplyParameterFromQuery] public string? Q { get; set; }
    [SupplyParameterFromQuery] public string? Sort { get; set; }
    [SupplyParameterFromQuery] public bool? Desc { get; set; }
    [SupplyParameterFromQuery] public int? Page { get; set; }
    [SupplyParameterFromQuery] public string? Status { get; set; }
    [SupplyParameterFromQuery] public DateOnly? From { get; set; }
    [SupplyParameterFromQuery] public DateOnly? To { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _state = new ListState
        {
            Path = "credits", Q = Q, Sort = Sort, Desc = Desc == true, Page = Page ?? 1,
            Status = string.IsNullOrEmpty(Status) ? null : Status, From = From, To = To,
        };
        _result = await Credits.ListAsync(_state.ToQuery(PageSizeOrDefault(await Parameters.GetIntAsync("ui.page_size", ListQuery.DefaultPageSize))));
        if (_state.IsInitial)
        {
            await Audit.TableViewedAsync("credit", "Кредити");
        }
    }
}
