@page "/deposits"
@attribute [Authorize(Policy = Permissions.PolicyPrefix + Permissions.DepositsView)]
@inherits AppPageBase
@inject DepositRepository Deposits
@inject DirectoryRepository Directories
@inject ParameterRepository Parameters

<PageHeader Title="Депозити" Icon="piggy-bank" Subtitle="Договори вкладів: розміщення, нарахування відсотків, повернення">
    @if (CurrentUser.Can(Permissions.DepositsManage))
    {
        <a class="btn btn-primary" href="deposits/new"><i class="bi bi-plus-lg me-1"></i>Розмістити вклад</a>
    }
</PageHeader>

<div class="kpi-grid">
    <KpiCard Title="Діючі вклади" Value="@Fmt.Number(_active)" Icon="hourglass-split" Tone="violet" />
    <KpiCard Title="Сума діючих вкладів (на сторінці)" Value="@Fmt.MoneyShort(_result.Items.Where(d => d.Status == DepositStatuses.Active).Sum(d => d.CurrentAmount))" Icon="cash-stack" Tone="green" />
</div>

<div class="panel">
    <form method="get" action="deposits" class="filter-bar">
        <SearchField Value="@Q" Placeholder="Клієнт, рахунок, продукт…" />
        <select name="status" class="form-select" data-autosubmit aria-label="Стан">
            <option value="">Усі стани</option>
            <option value="@DepositStatuses.Active" selected="@(Status == DepositStatuses.Active)">Діючі</option>
            <option value="@DepositStatuses.Closed" selected="@(Status == DepositStatuses.Closed)">Завершені</option>
            <option value="@DepositStatuses.ClosedEarly" selected="@(Status == DepositStatuses.ClosedEarly)">Розірвані достроково</option>
        </select>
        <select name="currency" class="form-select" data-autosubmit aria-label="Валюта">
            <option value="">Усі валюти</option>
            @foreach (var currency in _currencies)
            {
                <option value="@currency.Code" selected="@(Currency == currency.Code)">@currency.Code</option>
            }
        </select>
        <input type="date" name="from" class="form-control" value="@From?.ToString("yyyy-MM-dd")" title="Розміщено з" aria-label="Розміщено з" />
        <input type="date" name="to" class="form-control" value="@To?.ToString("yyyy-MM-dd")" title="Розміщено по" aria-label="Розміщено по" />
        @if (Sort is not null)
        {
            <input type="hidden" name="sort" value="@Sort" />
            <input type="hidden" name="desc" value="@(Desc == true ? "true" : "false")" />
        }
        <FilterButtons ResetUrl="deposits" />
    </form>
    <div class="table-wrap">
        <table class="table table-sm table-hover">
            <thead>
                <tr>
                    <SortLink Column="id" Title="№" State="_state" />
                    <SortLink Column="client" Title="Клієнт" State="_state" />
                    <SortLink Column="product" Title="Продукт" State="_state" />
                    <SortLink Column="amount" Title="Сума" State="_state" CssClass="num" />
                    <SortLink Column="rate" Title="Ставка" State="_state" CssClass="num" />
                    <SortLink Column="start" Title="Розміщено" State="_state" />
                    <SortLink Column="end" Title="Завершення" State="_state" />
                    <th class="num">Відсотки</th>
                    <SortLink Column="status" Title="Стан" State="_state" />
                </tr>
            </thead>
            <tbody>
                @foreach (var deposit in _result.Items)
                {
                    <tr>
                        <td><a href="deposits/@deposit.Id">@deposit.Id</a></td>
                        <td><a class="text-body" href="clients/@deposit.ClientId">@deposit.ClientName</a></td>
                        <td class="small">@deposit.ProductName @(deposit.Capitalization ? "· капіталізація" : "")</td>
                        <td class="num fw-semibold">@Fmt.Money(deposit.CurrentAmount, deposit.CurrencyCode)</td>
                        <td class="num">@Fmt.Rate(deposit.AnnualRate)</td>
                        <td class="small">@Fmt.Date(deposit.StartDate)</td>
                        <td class="small">@Fmt.Date(deposit.EndDate)</td>
                        <td class="num">@Fmt.Money(deposit.InterestPaid)</td>
                        <td><StatusBadge Kind="deposit" Value="@deposit.Status" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <Pager Result="_result" State="_state" />
</div>

@code {
    private ListState _state = new();
    private PagedResult<Deposit> _result = PagedResult<Deposit>.Empty(ListQuery.DefaultPageSize);
    private List<Currency> _currencies = [];
    private int _active;

    [SupplyParameterFromQuery] public string? Q { get; set; }
    [SupplyParameterFromQuery] public string? Sort { get; set; }
    [SupplyParameterFromQuery] public bool? Desc { get; set; }
    [SupplyParameterFromQuery] public int? Page { get; set; }
    [SupplyParameterFromQuery] public string? Status { get; set; }
    [SupplyParameterFromQuery] public string? Currency { get; set; }
    [SupplyParameterFromQuery] public DateOnly? From { get; set; }
    [SupplyParameterFromQuery] public DateOnly? To { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _state = new ListState
        {
            Path = "deposits", Q = Q, Sort = Sort, Desc = Desc == true, Page = Page ?? 1,
            Status = string.IsNullOrEmpty(Status) ? null : Status, Currency = string.IsNullOrEmpty(Currency) ? null : Currency,
            From = From, To = To,
        };
        _currencies = await Directories.CurrenciesAsync();
        _result = await Deposits.ListAsync(_state.ToQuery(PageSizeOrDefault(await Parameters.GetIntAsync("ui.page_size", ListQuery.DefaultPageSize))));
        _active = (await Deposits.ListAsync(new ListQuery { Status = DepositStatuses.Active, PageSize = 1 })).TotalCount;
        if (_state.IsInitial)
        {
            await Audit.TableViewedAsync("deposit", "Депозити");
        }
    }
}
