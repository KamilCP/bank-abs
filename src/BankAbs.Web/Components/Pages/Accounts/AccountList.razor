@page "/accounts"
@attribute [Authorize(Policy = Permissions.PolicyPrefix + Permissions.AccountsView)]
@inherits AppPageBase
@inject AccountRepository Accounts
@inject DirectoryRepository Directories
@inject ParameterRepository Parameters

<PageHeader Title="Рахунки" Icon="wallet2" Subtitle="Поточні, депозитні і кредитні рахунки клієнтів (IBAN)" />

<div class="panel">
    <form method="get" action="accounts" class="filter-bar">
        <SearchField Value="@Q" Placeholder="Номер рахунку або клієнт…" />
        <select name="kind" class="form-select" data-autosubmit aria-label="Тип рахунку">
            <option value="">Усі типи</option>
            <option value="@AccountTypes.Current" selected="@(Kind == AccountTypes.Current)">Поточні</option>
            <option value="@AccountTypes.Deposit" selected="@(Kind == AccountTypes.Deposit)">Депозитні</option>
            <option value="@AccountTypes.Credit" selected="@(Kind == AccountTypes.Credit)">Кредитні</option>
        </select>
        <select name="currency" class="form-select" data-autosubmit aria-label="Валюта">
            <option value="">Усі валюти</option>
            @foreach (var currency in _currencies)
            {
                <option value="@currency.Code" selected="@(Currency == currency.Code)">@currency.Code</option>
            }
        </select>
        <select name="status" class="form-select" data-autosubmit aria-label="Стан">
            <option value="">Усі стани</option>
            <option value="@AccountStatuses.Open" selected="@(Status == AccountStatuses.Open)">Відкриті</option>
            <option value="@AccountStatuses.Closed" selected="@(Status == AccountStatuses.Closed)">Закриті</option>
        </select>
        @if (Sort is not null)
        {
            <input type="hidden" name="sort" value="@Sort" />
            <input type="hidden" name="desc" value="@(Desc == true ? "true" : "false")" />
        }
        <FilterButtons ResetUrl="accounts" />
    </form>

    <div class="table-wrap">
        <table class="table table-sm table-hover">
            <thead>
                <tr>
                    <SortLink Column="number" Title="Номер рахунку" State="_state" />
                    <SortLink Column="client" Title="Клієнт" State="_state" />
                    <SortLink Column="type" Title="Тип" State="_state" />
                    <SortLink Column="currency" Title="Валюта" State="_state" />
                    <SortLink Column="balance" Title="Залишок" State="_state" CssClass="num" />
                    <th class="num">У гривні</th>
                    <SortLink Column="opened" Title="Відкрито" State="_state" />
                    <SortLink Column="status" Title="Стан" State="_state" />
                </tr>
            </thead>
            <tbody>
                @foreach (var account in _result.Items)
                {
                    <tr>
                        <td><a class="font-monospace" href="accounts/@account.Id">@Fmt.Iban(account.Number)</a></td>
                        <td><a href="clients/@account.ClientId" class="text-body">@account.ClientName</a></td>
                        <td class="small">@AccountTypes.Title(account.AccountType)</td>
                        <td>@account.CurrencyCode</td>
                        <td class="num fw-semibold">@Fmt.Money(account.Balance)</td>
                        <td class="num text-secondary">@Fmt.Money(account.BalanceBase)</td>
                        <td class="small">@Fmt.Date(account.OpenedAt)</td>
                        <td><StatusBadge Kind="account" Value="@account.Status" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <Pager Result="_result" State="_state" />
</div>

@code {
    private ListState _state = new();
    private PagedResult<Account> _result = PagedResult<Account>.Empty(ListQuery.DefaultPageSize);
    private List<Currency> _currencies = [];

    [SupplyParameterFromQuery] public string? Q { get; set; }
    [SupplyParameterFromQuery] public string? Sort { get; set; }
    [SupplyParameterFromQuery] public bool? Desc { get; set; }
    [SupplyParameterFromQuery] public int? Page { get; set; }
    [SupplyParameterFromQuery] public string? Kind { get; set; }
    [SupplyParameterFromQuery] public string? Status { get; set; }
    [SupplyParameterFromQuery] public string? Currency { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _state = new ListState
        {
            Path = "accounts", Q = Q, Sort = Sort, Desc = Desc == true, Page = Page ?? 1,
            Kind = NullIfEmpty(Kind), Status = NullIfEmpty(Status), Currency = NullIfEmpty(Currency),
        };
        _currencies = await Directories.CurrenciesAsync();
        var pageSize = PageSizeOrDefault(await Parameters.GetIntAsync("ui.page_size", ListQuery.DefaultPageSize));
        _result = await Accounts.ListAsync(_state.ToQuery(pageSize));
        if (_state.IsInitial)
        {
            await Audit.TableViewedAsync("account", "Рахунки");
        }
    }

    private static string? NullIfEmpty(string? value) => string.IsNullOrEmpty(value) ? null : value;
}
